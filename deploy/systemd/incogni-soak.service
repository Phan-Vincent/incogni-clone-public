[Unit]
Description=Run Personal Privacy Service synthetic soak checks
After=incogni-api.service incogni-worker.service tailscaled.service incogni-journal-audit.service
Wants=incogni-api.service incogni-worker.service incogni-journal-audit.service

[Service]
Type=oneshot
User=incogni
Group=incogni
WorkingDirectory=/opt/incogni
ExecStart=/opt/incogni/.venv/bin/incogni soak check
StateDirectory=incogni
StateDirectoryMode=0770
LoadCredential=incogni-master-key:/etc/incogni/credentials/incogni-master-key
LoadCredential=incogni-admin-password:/etc/incogni/credentials/incogni-admin-password
Environment=INCOGNI_DATA_DIR=/var/lib/incogni
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
ReadWritePaths=/var/lib/incogni
RestrictAddressFamilies=AF_UNIX AF_INET
