[Unit]
Description=Schedule Personal Privacy Service maintenance

[Service]
Type=oneshot
User=incogni
Group=incogni
WorkingDirectory=/opt/incogni
ExecStart=/opt/incogni/.venv/bin/incogni schedule
StateDirectory=incogni
StateDirectoryMode=0770
LoadCredential=incogni-master-key:/etc/incogni/credentials/incogni-master-key
LoadCredential=incogni-admin-password:/etc/incogni/credentials/incogni-admin-password
Environment=INCOGNI_DATA_DIR=/var/lib/incogni
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
ReadWritePaths=/var/lib/incogni
RestrictAddressFamilies=AF_UNIX
