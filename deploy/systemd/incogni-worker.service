[Unit]
Description=Personal Privacy Service durable worker
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=incogni
Group=incogni
WorkingDirectory=/opt/incogni
ExecStart=/opt/incogni/.venv/bin/incogni worker
Restart=on-failure
RestartSec=5s
StateDirectory=incogni
StateDirectoryMode=0770
LoadCredential=incogni-master-key:/etc/incogni/credentials/incogni-master-key
LoadCredential=incogni-admin-password:/etc/incogni/credentials/incogni-admin-password
Environment=INCOGNI_DATA_DIR=/var/lib/incogni
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/var/lib/incogni
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
